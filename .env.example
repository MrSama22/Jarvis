# Clave de API de OpenAI (Obtener en https://platform.openai.com/api-keys)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Clave de API de Google Gemini (Opcional)
GEMINI_API_KEY=

# Clave secreta para proteger el endpoint contra accesos no autorizados
# Configura esta misma clave en MacroDroid en la cabecera 'X-API-Key'
JARVIS_API_KEY=jarvis_secret_key_12345

# Proveedor de IA activo: 'openai' (recomendado) o 'gemini'
AI_PROVIDER=openai

# Modelo de conversación de OpenAI (gpt-4o-mini es ultra-rápido y económico)
OPENAI_MODEL=gpt-4o-mini

# Modelo para transcripción de audio
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Límite máximo de tokens de respuesta para ahorrar costos
MAX_RESPONSE_TOKENS=180

# Voz para Edge-TTS (100% gratuita, ahorra tokens de síntesis)
VOICE_NAME=es-MX-JorgeNeural

# Rutas de almacenamiento
CHROMA_PERSIST_DIR=./data/chroma
TEMP_AUDIO_DIR=./data/temp
PORT=8000
